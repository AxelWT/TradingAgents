JWT_SECRET_KEY=your-secret-key

DATABASE_URL=sqlite:///./tradingagents_web.db

CORS_ORIGINS=["http://localhost:5173","http://localhost:3004"]

# SMTP email configuration (for registration verification codes)
# Common providers: smtp.qq.com:465(SSL) / smtp.163.com:465(SSL) / smtp.gmail.com:587(TLS)
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=your-email@qq.com
SMTP_PASSWORD=your-smtp-authorization-code
SMTP_FROM_NAME=TradingAgents
SMTP_FROM_EMAIL=your-email@qq.com

# Admin & access control configuration
# Set both to auto-create/promote an admin on startup (see bootstrap_admin in app/main.py)
ACCESS_MODE=open
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=your-secure-password

# Email verification code configuration
VERIFY_CODE_LENGTH=6
VERIFY_CODE_EXPIRE_MINUTES=10
VERIFY_CODE_RESEND_SECONDS=60
VERIFY_CODE_MAX_ATTEMPTS=5
