# ===== Stage 1: build frontend =====
FROM node:20-alpine AS frontend-build
WORKDIR /app
COPY web/frontend/package*.json ./
RUN npm ci
COPY web/frontend/ ./
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

# ===== Stage 2: build python venv (core + backend deps) =====
FROM python:3.12-slim AS py-build
ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
WORKDIR /build
COPY . .
RUN pip install --no-cache-dir . \
 && pip install --no-cache-dir -r web/backend/requirements.txt

# ===== Stage 3: runtime =====
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    FRONTEND_DIST=/app/web/frontend/dist

COPY --from=py-build /opt/venv /opt/venv
COPY --from=py-build /build /app
COPY --from=frontend-build /app/dist /app/web/frontend/dist

RUN useradd --create-home appuser \
 && install -d -m 0755 -o appuser -g appuser /home/appuser/.tradingagents \
 && chown -R appuser:appuser /app

EXPOSE 8000
WORKDIR /app/web/backend
USER appuser
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--log-level", "info"]
